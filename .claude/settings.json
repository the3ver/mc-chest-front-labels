{
  "permissions": {
    "deny": [
      "Read(./build/classes/**)",
      "Read(./build/libs/**)",
      "Read(./build/tmp/**)",
      "Read(./build/resources/**)",
      "Read(./build/reports/**)",
      "Read(./build/loom-cache/**)",
      "Read(./build/run/*/saves/**)",
      "Read(./build/run/*/resources/**)",
      "Read(./build/run/*/logs/*.gz)",
      "Read(./.gradle/**)",
      "Read(./run/saves/**)",
      "Read(./run/resources/**)",
      "Read(./run/downloads/**)",
      "Read(./run/data/**)",
      "Read(./run/logs/*.gz)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/format-hook.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/check.sh\" --hook",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
