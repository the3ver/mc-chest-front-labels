#!/usr/bin/env bash
# Conventional Commits: typ(scope)!: beschreibung
head -1 "$1" | grep -qE '^((feat|fix|refactor|test|build|ci|docs|chore|style|perf|revert)(\([a-z0-9-]+\))?!?: .+|Merge .+|Revert .+)' && exit 0
echo "Commit-Nachricht nicht im Format 'typ(scope): beschreibung' (feat, fix, refactor, test, build, ci, docs, chore, style, perf, revert)" >&2
exit 1
